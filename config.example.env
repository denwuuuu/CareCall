# Copy this file to config.env and fill it in. Leave the Twilio lines empty
# to stay in simulation mode (no real calls).

# --- Real phone calls (from https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number calls come from, e.g. +15551234567
TWILIO_FROM_NUMBER=

# --- Optional: your own public address ---
# Twilio has to reach this app during a call to hear their answers. By default
# CareCall starts a free Cloudflare quick tunnel itself (brew install cloudflared).
# Set PUBLIC_URL only if you run your own tunnel; TUNNEL=off turns the built-in one off.
PUBLIC_URL=
# TUNNEL=off
APP_PASSWORD=

# --- Optional ---
# PORT=8790
# HOST=127.0.0.1   (use 0.0.0.0 to open it from your phone on home Wi-Fi; needs APP_PASSWORD)
